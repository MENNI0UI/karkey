# Example env for Karkey
# Development: copy to .env.local and fill values (do NOT commit secrets)

# App / Node
NODE_ENV=development
PORT=3000

# Database (fill with your local DB during development)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
# Leave DB_PASSWORD empty if you use no password locally
DB_PASSWORD=
# Use the actual local database name
DB_NAME=karkey

# Prisma Database URL (Required for Prisma)
DATABASE_URL="mysql://root:password@localhost:3306/karkey"

# Auth / JWT
JWT_SECRET=change_me_for_local

# Google OAuth (Required for Google Sign-In)
# Get these from https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
# AUTH_URL must match your production domain (e.g. https://karkey.space)
AUTH_URL=https://karkey.space
# AUTH_SECRET is required for NextAuth.js (generate with: openssl rand -base64 32)
AUTH_SECRET=your-generated-auth-secret

# Storage driver: local | s3
# - local : saves files under ./uploads (development)
# - s3    : uses S3-compatible provider (AWS S3 / DO Spaces / Cloudflare R2)
STORAGE_DRIVER=local

# S3-compatible settings (only used when STORAGE_DRIVER=s3)
# S3_ENDPOINT optional (e.g. https://nyc3.digitaloceanspaces.com or R2 endpoint)
S3_BUCKET=your-bucket-name
S3_REGION=your-region
S3_KEY=your-access-key
S3_SECRET=your-secret
S3_ENDPOINT=
# Optional public base url (e.g. CloudFront / DO CDN / Cloudflare) to build file URLs
STORAGE_BASE_URL=

# Notes:
# - Keep real secrets out of the repo. Use your platform's secret manager in production.
# - For local development keep STORAGE_DRIVER=local and ensure ./uploads exists or storage layer will create it.
