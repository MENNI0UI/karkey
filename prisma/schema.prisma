generator client {
  provider = "prisma-client-js"
  previewFeatures = ["fullTextSearch", "fullTextIndex"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model migrations {
  id          Int      @id @default(autoincrement())
  name        String   @unique(map: "name") @db.VarChar(255)
  executed_at DateTime @default(now()) @db.Timestamp(0)

  @@map("_migrations")
}

model admins {
  id               Int            @id @default(autoincrement())
  nom              String         @db.VarChar(50)
  prenom           String         @db.VarChar(50)
  password_hash    String         @db.VarChar(255)
  role             admins_role
  created_at       DateTime       @default(now()) @db.Timestamp(0)
  updated_at       DateTime       @default(now()) @db.Timestamp(0)
  password_version Int            @default(1)
  email            String?        @db.VarChar(255)
  recovery_key     String?        @db.VarChar(64)
  blacklists       blacklists[]
  direct_sales     direct_sales[]

  @@index([role], map: "idx_admins_role")
  @@index([recovery_key], map: "idx_admins_recovery_key")
}

model blacklists {
  id         Int       @id @default(autoincrement())
  user_id    Int       @unique(map: "unique_blacklist_user")
  admin_id   Int?
  reason     String?   @db.Text
  expires_at DateTime? @db.DateTime(0)
  created_at DateTime  @default(now()) @db.Timestamp(0)
  updated_at DateTime  @default(now()) @db.Timestamp(0)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "blacklists_ibfk_1")
  admins     admins?   @relation(fields: [admin_id], references: [id], onUpdate: Restrict, map: "blacklists_ibfk_2")

  @@index([admin_id], map: "admin_id")
  @@index([expires_at], map: "idx_blacklists_expires_at")
}

model deposits {
  id         Int             @id @default(autoincrement())
  user_id    Int
  auction_id Int?
  amount     Decimal         @db.Decimal(12, 2)
  status     deposits_status @default(pending)
  method     deposits_method @default(card)
  reference  String?
  created_at DateTime        @default(now()) @db.Timestamp(0)
  updated_at DateTime        @default(now()) @db.Timestamp(0)
  users      users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "deposits_ibfk_1")
  invoices   invoices[]

  @@index([auction_id], map: "auction_id")
  @@index([status], map: "idx_deposits_status")
  @@index([user_id], map: "idx_deposits_user_id")
}

model direct_sale_photos {
  id             Int          @id @default(autoincrement())
  direct_sale_id Int
  photo_url      String       @db.VarChar(500)
  blurhash       String?      @db.VarChar(500)
  position_order Int          @default(0)
  created_at     DateTime     @default(now()) @db.Timestamp(0)
  direct_sales   direct_sales @relation(fields: [direct_sale_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "direct_sale_photos_ibfk_1")

  @@index([direct_sale_id], map: "idx_direct_sale_photos_direct_sale_id")
  @@index([direct_sale_id, position_order], map: "idx_direct_sale_photos_order")
  @@index([position_order], map: "idx_direct_sale_photos_position")
}

model direct_sales {
  id                                 Int                               @id @default(autoincrement())
  user_id                            Int
  make                               String                            @db.VarChar(100)
  model                              String                            @db.VarChar(100)
  year                               Int
  mileage                            Int
  transmission                       direct_sales_transmission
  fuel_type                          direct_sales_fuel_type
  engine_size                        String?                           @db.VarChar(20)
  doors                              String?                           @db.VarChar(10)
  vehicle_condition                  direct_sales_vehicle_condition
  location                           String                            @db.VarChar(255)
  description                        String                            @db.Text
  price                              Decimal                           @db.Decimal(12, 2)
  carte_grise_url                    String?                           @db.VarChar(500)
  service_history_url                String?                           @db.VarChar(500)
  verification_status                direct_sales_verification_status? @default(pending)
  rejected_reason                    String?                           @db.Text
  reviewed_by                        Int?
  reviewed_at                        DateTime?                         @db.Timestamp(0)
  sale_status                        direct_sales_sale_status?         @default(available)
  buyer_id                           Int?
  sold_at                            DateTime?                         @db.Timestamp(0)
  created_at                         DateTime                          @default(now()) @db.Timestamp(0)
  updated_at                         DateTime                          @default(now()) @db.Timestamp(0)
  exterior_color                     String?                           @db.VarChar(50)
  interior_color                     String?                           @db.VarChar(50)
  is_original_paint                  Boolean?                          @default(true)
  special_features                   String?                           @db.Text
  auction_consent                    Boolean?                          @default(false)
  auction_reserve_price              Decimal?                          @db.Decimal(12, 2)
  auction_starting_price             Decimal?                          @db.Decimal(12, 2)
  moved_to_auction_at                DateTime?                         @db.Timestamp(0)
  returned_from_auction_at           DateTime?                         @db.Timestamp(0)
  auction_bid_count                  Int?                              @default(0)
  auction_current_bid                Decimal?                          @db.Decimal(12, 2)
  auction_end_date                   DateTime?                         @db.DateTime(0)
  auction_mode                       Boolean?                          @default(false)
  auction_start_date                 DateTime?                         @db.DateTime(0)
  auction_status                     direct_sales_auction_status?      @default(none)
  auction_winner_id                  Int?
  views                              Int                               @default(0)
  direct_sale_photos                 direct_sale_photos[]
  users_direct_sales_user_idTousers  users                             @relation("direct_sales_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "direct_sales_ibfk_1")
  admins                             admins?                           @relation(fields: [reviewed_by], references: [id], onUpdate: Restrict, map: "direct_sales_ibfk_2")
  users_direct_sales_buyer_idTousers users?                            @relation("direct_sales_buyer_idTousers", fields: [buyer_id], references: [id], onUpdate: Restrict, map: "direct_sales_ibfk_3")

  @@index([buyer_id], map: "buyer_id")
  @@index([user_id], map: "idx_direct_sales_user_id")
  @@index([reviewed_by], map: "reviewed_by")
  @@index([make, model], map: "idx_direct_sales_make_model")
  @@index([make, year])
  @@index([location, price])
  @@index([fuel_type])
  @@index([transmission])
  @@index([sale_status])
  @@index([verification_status])
  @@index([created_at])
  @@index([auction_consent])
  
  // Performance Indexes for Range Filters
  @@index([mileage], map: "idx_direct_sales_mileage")
  @@index([price], map: "idx_direct_sales_price")
  @@index([year], map: "idx_direct_sales_year")

  // Composite Indexes for main listings
  @@index([verification_status, sale_status, created_at], map: "idx_ds_status_composite")
  @@index([auction_mode, auction_status, verification_status, auction_end_date], map: "idx_ds_auction_composite")
  
  // Full Text Search Index
  @@fulltext([make, model, location, description])
}

model direct_sales_contacts {
  id             Int      @id @default(autoincrement())
  direct_sale_id Int
  user_id        Int?
  name           String?  @db.VarChar(255)
  email          String?  @db.VarChar(255)
  phone          String?  @db.VarChar(100)
  message        String?  @db.Text
  processed      Boolean  @default(false)
  created_at     DateTime @default(now()) @db.DateTime(0)

  @@index([direct_sale_id], map: "idx_direct_sale_id")
  @@index([user_id], map: "idx_user_id")
}

model direct_sales_saved_searches {
  id               Int       @id @default(autoincrement())
  user_id          Int
  name             String    @db.VarChar(255)
  params           String    @db.LongText
  is_active        Boolean   @default(true)
  last_notified_at DateTime? @db.DateTime(0)
  created_at       DateTime  @default(now()) @db.DateTime(0)

  @@index([user_id], map: "idx_user_id")
}

model direct_sales_watchlist {
  id             Int      @id @default(autoincrement())
  user_id        Int
  direct_sale_id Int
  created_at     DateTime @default(now()) @db.Timestamp(0)

  @@unique([user_id, direct_sale_id], map: "unique_user_direct_sale")
}

model inspections {
  id           Int                @id @default(autoincrement())
  vehicle_id   Int
  requested_by Int
  scheduled_at DateTime?          @db.DateTime(0)
  status       inspections_status @default(pending)
  report_url   String?            @db.VarChar(500)
  created_at   DateTime           @default(now()) @db.Timestamp(0)
  updated_at   DateTime           @default(now()) @db.Timestamp(0)
  users        users              @relation(fields: [requested_by], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "inspections_ibfk_2")

  @@index([status], map: "idx_inspections_status")
  @@index([vehicle_id], map: "idx_inspections_vehicle_id")
  @@index([requested_by], map: "requested_by")
}

model invoices {
  id              Int             @id @default(autoincrement())
  user_id         Int
  subscription_id Int?
  deposit_id      Int?
  total           Decimal         @db.Decimal(12, 2)
  status          invoices_status @default(issued)
  issued_at       DateTime?       @default(now()) @db.DateTime(0)
  due_at          DateTime?       @db.DateTime(0)
  paid_at         DateTime?       @db.DateTime(0)
  created_at      DateTime        @default(now()) @db.Timestamp(0)
  updated_at      DateTime        @default(now()) @db.Timestamp(0)
  users           users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "invoices_ibfk_1")
  subscriptions   subscriptions?  @relation(fields: [subscription_id], references: [id], onUpdate: Restrict, map: "invoices_ibfk_2")
  deposits        deposits?       @relation(fields: [deposit_id], references: [id], onUpdate: Restrict, map: "invoices_ibfk_3")
  payments        payments[]

  @@index([deposit_id], map: "deposit_id")
  @@index([status], map: "idx_invoices_status")
  @@index([user_id], map: "idx_invoices_user_id")
  @@index([subscription_id], map: "subscription_id")
}

model notifications {
  id          Int                 @id @default(autoincrement())
  user_id     Int
  title       String              @db.VarChar(255)
  message     String              @db.Text
  type        notifications_type? @default(info)
  is_read     Boolean?            @default(false)
  created_at  DateTime            @default(now()) @db.Timestamp(0)
  auction_id  Int?
  users       users               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "notifications_ibfk_1")

  @@index([auction_id], map: "auction_id")
  @@index([is_read], map: "idx_notifications_is_read")
  @@index([user_id, created_at], map: "idx_notifications_user_created")
  @@index([user_id], map: "idx_notifications_user_id")
  @@index([user_id, is_read], map: "idx_notifications_user_read")
}

model payments {
  id           Int               @id @default(autoincrement())
  user_id      Int
  invoice_id   Int?
  amount       Decimal           @db.Decimal(12, 2)
  status       payments_status   @default(pending)
  provider     payments_provider @default(other)
  provider_ref String?
  created_at   DateTime          @default(now()) @db.Timestamp(0)
  updated_at   DateTime          @default(now()) @db.Timestamp(0)
  users        users             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "payments_ibfk_1")
  invoices     invoices?         @relation(fields: [invoice_id], references: [id], onUpdate: Restrict, map: "payments_ibfk_2")

  @@index([status], map: "idx_payments_status")
  @@index([user_id], map: "idx_payments_user_id")
  @@index([invoice_id], map: "invoice_id")
}

model plans {
  id             Int             @id @default(autoincrement())
  name           String          @db.VarChar(100)
  name_ar        String?         @db.VarChar(100)
  name_fr        String?         @db.VarChar(100)
  name_es        String?         @db.VarChar(100)
  price          Decimal         @db.Decimal(12, 2)
  currency       String          @default("MAD") @db.Char(3)
  duration_days  Int
  bid_limit      Int?
  description    String?         @db.Text
  description_ar String?         @db.Text
  description_fr String?         @db.Text
  description_es String?         @db.Text
  features       String?         @db.LongText
  features_ar    String?         @db.LongText
  features_fr    String?         @db.LongText
  features_es    String?         @db.LongText
  popular        Boolean?        @default(false)
  priority       Int?            @default(0)
  status         plans_status    @default(active)
  created_at     DateTime        @default(now()) @db.Timestamp(0)
  updated_at     DateTime        @default(now()) @db.Timestamp(0)
  subscriptions  subscriptions[]

  @@index([priority], map: "idx_plans_priority")
}

model requests {
  id          Int             @id @default(autoincrement())
  user_id     Int
  type        requests_type   @default(other)
  status      requests_status @default(pending)
  payload     String?         @db.LongText
  admin_notes String?         @db.Text
  created_at  DateTime        @default(now()) @db.Timestamp(0)
  updated_at  DateTime        @default(now()) @db.Timestamp(0)
  users       users           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "requests_ibfk_1")

  @@index([status], map: "idx_requests_status")
  @@index([user_id], map: "idx_requests_user_id")
}

/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model saved_searches {
  id               Int       @id @default(autoincrement())
  user_id          Int
  name             String    @db.VarChar(200)
  params           String    @db.LongText
  is_active        Boolean?  @default(true)
  last_notified_at DateTime? @db.DateTime(0)
  created_at       DateTime  @default(now()) @db.Timestamp(0)
  updated_at       DateTime  @default(now()) @db.Timestamp(0)
  users            users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "saved_searches_ibfk_1")

  @@index([created_at], map: "idx_created_at")
  @@index([is_active], map: "idx_is_active")
  @@index([user_id], map: "idx_user_id")
}

model subscriptions {
  id         Int                  @id @default(autoincrement())
  user_id    Int
  plan_id    Int
  status     subscriptions_status @default(pending)
  start_date DateTime?            @db.DateTime(0)
  end_date   DateTime?            @db.DateTime(0)
  created_at DateTime             @default(now()) @db.Timestamp(0)
  updated_at DateTime             @default(now()) @db.Timestamp(0)
  invoices   invoices[]
  users      users                @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict, map: "subscriptions_ibfk_1")
  plans      plans                @relation(fields: [plan_id], references: [id], onUpdate: Restrict, map: "subscriptions_ibfk_2")

  @@index([status], map: "idx_subscriptions_status")
  @@index([user_id], map: "idx_subscriptions_user_id")
  @@index([plan_id], map: "plan_id")
}

model users {
  id                                        Int                       @id @default(autoincrement())
  username                                  String                    @unique(map: "username") @db.VarChar(20)
  first_name                                String?                   @db.VarChar(50)
  last_name                                 String?                   @db.VarChar(50)
  email                                     String                    @unique(map: "email") @db.VarChar(255)
  password_hash                             String?                   @db.VarChar(255)
  phone_number                              String?                   @db.VarChar(20)
  profile_picture                           String?                   @db.VarChar(500)
  user_type                                 users_user_type
  created_at                                DateTime                  @default(now()) @db.Timestamp(0)
  updated_at                                DateTime                  @default(now()) @db.Timestamp(0)
  google_id                                 String?                   @unique(map: "google_id") @db.VarChar(255)
  is_profile_complete                       Boolean                   @default(true)
  blacklists                                blacklists?
  deposits                                  deposits[]
  direct_sales_direct_sales_user_idTousers  direct_sales[]            @relation("direct_sales_user_idTousers")
  direct_sales_direct_sales_buyer_idTousers direct_sales[]            @relation("direct_sales_buyer_idTousers")
  inspections                               inspections[]
  invoices                                  invoices[]
  notifications                             notifications[]
  payments                                  payments[]
  requests                                  requests[]
  saved_searches                            saved_searches[]
  subscriptions                             subscriptions[]
  auction_reminders                         auction_reminders[]

  @@index([email], map: "idx_users_email")
}

model auction_reminders {
  id         Int      @id @default(autoincrement())
  email      String   @unique(map: "unique_email") @db.VarChar(255)
  user_id    Int?
  is_active  Boolean  @default(true)
  language   String   @default("en") @db.VarChar(5)
  created_at DateTime @default(now()) @db.Timestamp(0)
  updated_at DateTime @default(now()) @db.Timestamp(0)

  users      users?   @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: Restrict)
  @@index([user_id], map: "idx_user_id")
}

model verification_log {
  id          Int                          @id @default(autoincrement())
  entity_type verification_log_entity_type
  entity_id   Int
  action      verification_log_action
  reason      String?                      @db.VarChar(500)
  admin_id    Int
  admin_name  String                       @db.VarChar(100)
  created_at  DateTime                     @default(now()) @db.Timestamp(0)

  @@index([action], map: "idx_verification_log_action")
  @@index([admin_id], map: "idx_verification_log_admin")
  @@index([created_at], map: "idx_verification_log_date")
  @@index([entity_type, entity_id], map: "idx_verification_log_entity")
}

model karkey_cars {
  id                Int                      @id @default(autoincrement())
  make              String                   @db.VarChar(100)
  model             String                   @db.VarChar(100)
  year              Int
  mileage           Int
  transmission      karkey_cars_transmission
  fuel_type         karkey_cars_fuel_type
  engine_size       String?                  @db.VarChar(20)
  doors             String?                  @db.VarChar(10)
  vehicle_condition karkey_cars_condition
  location          String                   @db.VarChar(255)
  description       String                   @db.Text
  price             Decimal                  @db.Decimal(12, 2)
  created_at        DateTime                 @default(now()) @db.Timestamp(0)
  updated_at        DateTime                 @default(now()) @db.Timestamp(0)
  is_active         Boolean                  @default(true)
  added_by          Int
  exterior_color    String?                  @db.VarChar(50)
  interior_color    String?                  @db.VarChar(50)
  is_original_paint Boolean?                 @default(true)
  special_features  String?                  @db.Text
  inquiries         karkey_car_inquiries[]
  photos            karkey_car_photos[]

  @@index([is_active], map: "idx_karkey_cars_active")
  @@index([added_by], map: "idx_karkey_cars_added_by")
  @@index([make, model])
  @@index([make, year])
  @@index([location, price])
  @@index([created_at])

  // Performance Indexes for Range Filters
  @@index([mileage], map: "idx_karkey_cars_mileage")
  @@index([price], map: "idx_karkey_cars_price")
  @@index([year], map: "idx_karkey_cars_year")

  // Composite Index for main listing
  @@index([is_active, created_at], map: "idx_karkey_cars_active_composite")

  // Full Text Search Index
  @@fulltext([make, model, location, description])
}

model karkey_car_photos {
  id             Int         @id @default(autoincrement())
  karkey_car_id  Int
  photo_url      String      @db.VarChar(500)
  blurhash       String?     @db.VarChar(500)
  position_order Int         @default(0)
  created_at     DateTime    @default(now()) @db.Timestamp(0)
  karkey_cars    karkey_cars @relation(fields: [karkey_car_id], references: [id], onDelete: Cascade)

  @@index([karkey_car_id], map: "idx_karkey_car_photos_car_id")
  @@index([karkey_car_id, position_order], map: "idx_karkey_car_photos_order")
}

model karkey_car_inquiries {
  id            Int         @id @default(autoincrement())
  karkey_car_id Int
  user_id       Int?
  name          String      @db.VarChar(255)
  email         String?     @db.VarChar(255)
  phone         String?     @db.VarChar(100)
  message       String      @db.Text
  created_at    DateTime    @default(now()) @db.Timestamp(0)
  is_processed  Boolean     @default(false)
  processed_at  DateTime?   @db.Timestamp(0)
  processed_by  Int?
  karkey_cars   karkey_cars @relation(fields: [karkey_car_id], references: [id], onDelete: Cascade)

  @@index([karkey_car_id], map: "idx_karkey_car_inquiries_car_id")
  @@index([is_processed], map: "idx_karkey_car_inquiries_processed")
  @@index([user_id], map: "idx_karkey_car_inquiries_user_id")
}

model verification_codes {
  id         Int                     @id @default(autoincrement())
  email      String                  @db.VarChar(255)
  code       String                  @db.VarChar(6)
  type       verification_codes_type @default(email)
  expires_at DateTime                @db.DateTime(0)
  verified   Boolean                 @default(false)
  attempts   Int                     @default(0)
  created_at DateTime                @default(now()) @db.Timestamp(0)

  @@index([email, type], map: "idx_verification_codes_email_type")
  @@index([code], map: "idx_verification_codes_code")
  @@index([expires_at], map: "idx_verification_codes_expires")
}

enum verification_log_entity_type {
  user
  vehicle
}

enum requests_type {
  verification
  auction
  withdrawal
  support
  other
}

enum requests_status {
  pending
  approved
  rejected
  cancelled
  in_progress
}

enum subscriptions_status {
  pending
  active
  expired
  cancelled
}

enum verification_log_action {
  approved
  rejected
}

enum admins_role {
  ceo
  verification
  finance
  support
}

enum deposits_status {
  pending
  paid
  refunded
  failed
}

enum inspections_status {
  pending
  scheduled
  completed
  cancelled
}

enum notifications_type {
  success
  error
  info
  warning
  auction_migration
  auction_return
  auction_won
  auction_outbid
  auction_sold
  auction_reserve_not_met
  auction_no_bids
}

enum payments_status {
  pending
  succeeded
  failed
  refunded
}

enum deposits_method {
  card
  bank
  cash
  other
}

enum invoices_status {
  draft
  issued
  paid
  void
  refunded
}

enum payments_provider {
  stripe
  paypal
  transfer
  cash
  other
}

enum direct_sales_transmission {
  manual
  automatic
}

enum direct_sales_fuel_type {
  gasoline
  diesel
  electric
  hybrid
}

enum users_user_type {
  individual
  dealer
  company
}

enum direct_sales_vehicle_condition {
  excellent
  good
  fair
  poor
}

enum plans_status {
  active
  inactive
}

enum direct_sales_verification_status {
  pending
  approved
  rejected
}

enum direct_sales_sale_status {
  available
  sold
  reserved
  cancelled
}

enum direct_sales_auction_status {
  none
  pending
  active
  completed
  reserve_not_met
  ended_no_bids
}

enum karkey_cars_transmission {
  manual
  automatic
}

enum karkey_cars_fuel_type {
  gasoline
  diesel
  electric
  hybrid
}

enum karkey_cars_condition {
  excellent
  good
  fair
  poor
}

enum verification_codes_type {
  email
  phone
}
